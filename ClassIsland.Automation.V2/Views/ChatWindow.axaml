<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClassIsland.Automation.Core.Models;assembly=ClassIsland.Automation.Core"
        xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:helpers="clr-namespace:ClassIsland.Core.Helpers;assembly=ClassIsland.Core"
        xmlns:avalonia="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:Class="ClassIsland.Automation.V2.Views.ChatWindow"
        Title="IslandAgent" Width="640" Height="720"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- 会话列表条目（由代码构建，样式集中在这里定义以便跟随主题切换） -->
        <Style Selector="Border.sessionItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="6,5,4,5"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>
        <Style Selector="Border.sessionItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.sessionItem.active">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <!-- 选中指示条：未选中时透明占位，避免切换时文字左右跳动 -->
        <Style Selector="Border.sessionBar">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Border.sessionBar.active">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
        <!-- 会话图标：未选中描边次要色，选中实心强调色 -->
        <Style Selector="Path.sessionIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Path.sessionIcon.active">
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
        <Style Selector="TextBlock.sessionTitle">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBlock.sessionTitle.active">
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="TextBlock.sessionTime">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <!-- 删除按钮：平时低对比，悬停才浮现 -->
        <Style Selector="Border.sessionDelete">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.4"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Border.sessionDelete:pointerover">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Path.sessionDeleteIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto, *" Margin="16">
        <!-- 会话列表侧栏（仅多会话模式显示，可折叠） -->
        <Border Name="SessionSidebarBorder" Width="204" Margin="0,0,12,0" IsVisible="False"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="10" Padding="10,10,10,6">
            <Grid RowDefinitions="Auto, *">
                <!-- 头部：气泡图标 + 标题 + 会话数徽标 + 新建按钮 -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="2,0,0,8">
                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"
                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                          Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="7,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="会话" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Name="SessionCountBadge" Padding="5,0" CornerRadius="7" VerticalAlignment="Center"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock Name="SessionCountText" Text="0" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button Name="SidebarNewSessionButton" Grid.Column="2" Width="26" Height="26" Padding="0"
                            ToolTip.Tip="新建会话" VerticalAlignment="Center">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="12" Height="12" Stretch="Uniform"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Name="SessionListStackPanel"/>
                </ScrollViewer>

                <!-- 空状态：没有任何会话时的占位 -->
                <StackPanel Name="SessionEmptyState" Grid.Row="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center" IsVisible="False">
                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"
                          Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center"
                          Fill="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.4"/>
                    <TextBlock Text="还没有会话" FontSize="11" Margin="0,7,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto, Auto">
        <!-- 头部说明、模型选择与状态 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
            <StackPanel Spacing="2">
                <TextBlock Text="AI 助手" FontSize="18" FontWeight="Bold"/>
                <TextBlock Name="HeaderSubTitle" Text="连续智能调课、课表问答与设置调整" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 对话界面模型快速切换下拉框 -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Name="SidebarToggleButton" Content="会话列表" FontSize="12" Padding="12,4" VerticalAlignment="Center" IsVisible="False"/>
                <Button Name="NewSessionButton" FontSize="12" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="新建会话" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="当前模型:" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox Name="ModelSelectComboBox" MinWidth="180" MaxWidth="260" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 消息历史对话流（气泡式对话界面） -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="MessagesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ChatMessageItem">
                            <Grid Margin="0,6">
                                <!-- 用户消息气泡（右对齐） -->
                                <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="460" Margin="30,0,0,0">
                                    <TextBlock Text="{Binding TimeString}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right" Margin="0,0,4,2"/>
                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="14,14,2,14" Padding="12,8">
                                        <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontSize="14"/>
                                    </Border>
                                </StackPanel>

                                <!-- AI 助手消息气泡（左对齐，支持 Markdown 表格与排版渲染） -->
                                <StackPanel IsVisible="{Binding IsAssistant}" HorizontalAlignment="Left" MaxWidth="500" Margin="0,0,30,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,2">
                                        <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TimeString}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="14,14,14,2" Padding="12,10">
                                        <StackPanel Spacing="6">
                                            <!-- 工具调用徽标 -->
                                            <ItemsControl ItemsSource="{Binding ToolBadges}" IsVisible="{Binding HasToolBadges}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 消息文本（Markdown 富文本渲染：表格、加粗、列表、代码块） -->
                                            <mdxaml:MarkdownScrollViewer
                                                Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                                                Markdown="{Binding Content}">
                                                <mdxaml:MarkdownScrollViewer.Styles>
                                                    <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml"/>
                                                    <Style Selector="mdxaml|MarkdownScrollViewer /template/ ScrollViewer">
                                                        <Setter Property="Padding" Value="0"/>
                                                    </Style>
                                                    <Style Selector="avalonia|CTextBlock">
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                                    </Style>
                                                </mdxaml:MarkdownScrollViewer.Styles>
                                            </mdxaml:MarkdownScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 系统消息（居中） -->
                                <StackPanel IsVisible="{Binding IsSystem}" HorizontalAlignment="Center" Margin="0,4">
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding Content}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 图片状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,6">
            <Button Name="SelectImageButton" Content="添加课表图片"/>
            <TextBlock Name="ImageStatusTextBlock" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="未选择图片"/>
            <Button Name="ClearImageButton" Content="清除" IsVisible="False"/>
        </StackPanel>

        <!-- 输入与发送（支持回车发送，Shift+Enter换行） -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
            <TextBox Name="InputTextBox"
                     Watermark="请输入文本..."
                     AcceptsReturn="True" TextWrapping="Wrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     MinHeight="36" MaxHeight="120"
                     VerticalContentAlignment="Center"/>
            <Button Name="SendButton" Grid.Column="1" Content="发送" Margin="8,0,0,0" Classes="accent"
                    VerticalAlignment="Bottom"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
