<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:ClassIsland.Automation.Core.Models;assembly=ClassIsland.Automation.Core"
        xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
        xmlns:helpers="clr-namespace:ClassIsland.Core.Helpers;assembly=ClassIsland.Core"
        xmlns:avalonia="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
        x:Class="ClassIsland.Automation.V2.Views.ChatWindow"
        Title="IslandAgent" Width="680" Height="720"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <!-- 无边框图标按钮：抹掉底色与内边距，只留图标和一圈悬停反馈 -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>

        <!-- 会话条目：单行，图标 + 标题 + 时间（悬停时时间让位给删除） -->
        <Style Selector="Border.sessionItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="7,0,5,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style Selector="Border.sessionItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>

        <!-- 选中态：强调色低透明度底纹，叠在悬停底色之上，不遮挡文字 -->
        <Style Selector="Border.sessionTint">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.sessionTint.active">
            <Setter Property="Opacity" Value="0.12"/>
        </Style>

        <Style Selector="Path.sessionIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Path.sessionIcon.active">
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="TextBlock.sessionTitle">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="TextBlock.sessionTitle.active">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>

        <Style Selector="TextBlock.sessionTime">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 悬停：时间淡出、删除浮现，两者共用同一格，行内始终只有一个控件可见 -->
        <Style Selector="Border.sessionItem:pointerover TextBlock.sessionTime">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.sessionItem:pointerover Border.sessionDelete">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Border.sessionDelete">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="Path.sessionDeleteIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- 顺序要紧：Avalonia 里后定义的样式优先，悬停态必须写在基础样式之后 -->
        <Style Selector="Border.sessionDelete:pointerover Path.sessionDeleteIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="Auto, *" Margin="16">
        <!-- 会话列表侧栏（仅多会话模式显示，可折叠） -->
        <Border Name="SessionSidebarBorder" Width="200" Margin="0,0,10,0" IsVisible="False"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="12" Padding="8,10,8,8">
            <Grid RowDefinitions="Auto, *">
                <!-- 头部：小标题 + 计数，右侧两枚无边框图标按钮（新建 / 收起） -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="6,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="会话" FontSize="11" FontWeight="SemiBold" Opacity="0.5"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Name="SessionCountText" Text="0" FontSize="11" Margin="6,0,0,0" Opacity="0.3"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </StackPanel>
                    <Button Name="SidebarNewSessionButton" Grid.Column="1" Classes="ghost" ToolTip.Tip="新建会话">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="11" Height="11" Stretch="Uniform"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Button Name="SidebarCollapseButton" Grid.Column="2" Classes="ghost" Margin="2,0,0,0"
                            ToolTip.Tip="收起会话">
                        <Path Data="M15.41 7.41L14 6l-6 6 6 6 1.41-1.41L10.83 12z"
                              Width="11" Height="11" Stretch="Uniform"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>
                <ScrollViewer Grid.Row="1">
                    <StackPanel Name="SessionListStackPanel"/>
                </ScrollViewer>

                <!-- 空状态：没有任何会话时的占位 -->
                <StackPanel Name="SessionEmptyState" Grid.Row="1" VerticalAlignment="Center"
                            HorizontalAlignment="Center" IsVisible="False">
                    <Path Data="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H5.17L4 17.17V4h16v12z"
                          Width="24" Height="24" Stretch="Uniform" HorizontalAlignment="Center"
                          Fill="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.35"/>
                    <TextBlock Text="还没有会话" FontSize="11" Margin="0,8,0,0" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto, Auto">
        <!-- 头部说明、模型选择与状态 -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" Margin="0,0,0,12">
            <!-- 侧栏收起后，展开按钮停在它消失的位置，而不是混进右侧的模型选择区 -->
            <Button Name="SidebarToggleButton" Grid.Column="0" Classes="ghost" Width="28" Height="28"
                    ToolTip.Tip="展开会话列表" VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="False">
                <Path Data="M10 6L8.59 7.41 13.17 12l-4.58 4.59L10 18l6-6z"
                      Width="12" Height="12" Stretch="Uniform"
                      Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
            </Button>

            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                <TextBlock Text="AI 助手" FontSize="18" FontWeight="Bold"/>
                <TextBlock Name="HeaderSubTitle" Text="连续智能调课、课表问答与设置调整" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>

            <!-- 模型快速切换（单会话模式下这里还会出现「新建会话」） -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Name="NewSessionButton" FontSize="12" Padding="10,4" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"
                              Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center"
                              Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="新建会话" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="当前模型:" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                <ComboBox Name="ModelSelectComboBox" MinWidth="170" MaxWidth="240" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 消息历史对话流（气泡式对话界面） -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="8">
            <ScrollViewer Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl Name="MessagesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="models:ChatMessageItem">
                            <Grid Margin="0,6">
                                <!-- 用户消息气泡（右对齐） -->
                                <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right" MaxWidth="460" Margin="30,0,0,0">
                                    <TextBlock Text="{Binding TimeString}" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               HorizontalAlignment="Right" Margin="0,0,4,2"/>
                                    <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                            CornerRadius="14,14,2,14" Padding="12,8">
                                        <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" FontSize="14"/>
                                    </Border>
                                </StackPanel>

                                <!-- AI 助手消息气泡（左对齐，支持 Markdown 表格与排版渲染） -->
                                <StackPanel IsVisible="{Binding IsAssistant}" HorizontalAlignment="Left" MaxWidth="500" Margin="0,0,30,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,2">
                                        <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <TextBlock Text="{Binding TimeString}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="14,14,14,2" Padding="12,10">
                                        <StackPanel Spacing="6">
                                            <!-- 工具调用徽标 -->
                                            <ItemsControl ItemsSource="{Binding ToolBadges}" IsVisible="{Binding HasToolBadges}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,2">
                                                            <TextBlock Text="{Binding}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- 消息文本（Markdown 富文本渲染：表格、加粗、列表、代码块） -->
                                            <mdxaml:MarkdownScrollViewer
                                                Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                                                Markdown="{Binding Content}">
                                                <mdxaml:MarkdownScrollViewer.Styles>
                                                    <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml"/>
                                                    <Style Selector="mdxaml|MarkdownScrollViewer /template/ ScrollViewer">
                                                        <Setter Property="Padding" Value="0"/>
                                                    </Style>
                                                    <Style Selector="avalonia|CTextBlock">
                                                        <Setter Property="FontSize" Value="14"/>
                                                        <Setter Property="Margin" Value="0,0,0,4"/>
                                                    </Style>
                                                </mdxaml:MarkdownScrollViewer.Styles>
                                            </mdxaml:MarkdownScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- 系统消息（居中） -->
                                <StackPanel IsVisible="{Binding IsSystem}" HorizontalAlignment="Center" Margin="0,4">
                                    <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding Content}" FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- 图片状态栏 -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,6">
            <Button Name="SelectImageButton" Content="添加课表图片"/>
            <TextBlock Name="ImageStatusTextBlock" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" Text="未选择图片"/>
            <Button Name="ClearImageButton" Content="清除" IsVisible="False"/>
        </StackPanel>

        <!-- 输入与发送（支持回车发送，Shift+Enter换行） -->
        <Grid Grid.Row="3" ColumnDefinitions="*, Auto">
            <TextBox Name="InputTextBox"
                     Watermark="请输入文本..."
                     AcceptsReturn="True" TextWrapping="Wrap"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Hidden"
                     MinHeight="36" MaxHeight="120"
                     VerticalContentAlignment="Center"/>
            <Button Name="SendButton" Grid.Column="1" Content="发送" Margin="8,0,0,0" Classes="accent"
                    VerticalAlignment="Bottom"/>
        </Grid>
        </Grid>
    </Grid>
</Window>
