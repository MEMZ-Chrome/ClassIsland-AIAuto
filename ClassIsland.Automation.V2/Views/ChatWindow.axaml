<ci:MyWindow xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:models="clr-namespace:ClassIsland.Automation.Core.Models;assembly=ClassIsland.Automation.Core"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:helpers="clr-namespace:ClassIsland.Core.Helpers;assembly=ClassIsland.Core"
             xmlns:avalonia="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia"
             x:Class="ClassIsland.Automation.V2.Views.ChatWindow"
             Title="AI 助手" Width="760" Height="720"
             MinWidth="540" MinHeight="480"
             EnableMicaWindow="True"
             WindowStartupLocation="CenterScreen">

    <ci:MyWindow.Styles>
        <!-- 无边框图标按钮 -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>

        <!-- 会话条目：单行，图标 + 标题 + 时间（悬停时时间让位给删除） -->
        <Style Selector="Border.sessionItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,0,6,0"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Height" Value="34"/>
        </Style>
        <Style Selector="Border.sessionItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>

        <!-- 选中态：强调色低透明度底纹，叠在悬停底色之上 -->
        <Style Selector="Border.sessionTint">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Border.sessionTint.active">
            <Setter Property="Opacity" Value="0.12"/>
        </Style>

        <Style Selector="Path.sessionIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
            <Setter Property="Opacity" Value="0.45"/>
        </Style>
        <Style Selector="Path.sessionIcon.active">
            <Setter Property="Fill" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
            <Setter Property="Opacity" Value="1"/>
        </Style>

        <Style Selector="TextBlock.sessionTitle">
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="TextBlock.sessionTitle.active">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
        </Style>

        <Style Selector="TextBlock.sessionTime">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="Opacity" Value="0.8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 悬停：时间淡出、删除浮现，两者共用同一格 -->
        <Style Selector="Border.sessionItem:pointerover TextBlock.sessionTime">
            <Setter Property="Opacity" Value="0"/>
        </Style>
        <Style Selector="Border.sessionItem:pointerover Border.sessionDelete">
            <Setter Property="Opacity" Value="0.85"/>
        </Style>
        <Style Selector="Border.sessionDelete">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
        </Style>
        <Style Selector="Path.sessionDeleteIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.sessionDelete:pointerover Path.sessionDeleteIcon">
            <Setter Property="Fill" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </ci:MyWindow.Styles>

    <Grid ColumnDefinitions="Auto, *" Margin="14">
        <!-- 会话列表侧栏（仅多会话模式显示，可折叠） -->
        <Border Name="SessionSidebarBorder" Width="216" Margin="0,0,12,0" IsVisible="False"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10" Padding="8,10,8,8">
            <Grid RowDefinitions="Auto, Auto, *">
                <!-- 头部：图标 + 小标题 + 计数胶囊，右侧新建与收起按钮 -->
                <Grid Grid.Row="0" ColumnDefinitions="*, Auto, Auto" Margin="6,0,2,6">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <ci:FluentIcon Glyph="&#xE3FE;" FontSize="14"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="会话列表" FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center"/>
                        <Border CornerRadius="8" Padding="6,1"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                VerticalAlignment="Center">
                            <TextBlock Name="SessionCountText" Text="0" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Border>
                    </StackPanel>
                    <Button Name="SidebarNewSessionButton" Grid.Column="1" Classes="ghost"
                            ToolTip.Tip="新建会话">
                        <ci:FluentIcon Glyph="&#xE00D;" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                    <Button Name="SidebarCollapseButton" Grid.Column="2" Classes="ghost"
                            Margin="2,0,0,0" ToolTip.Tip="收起会话列表">
                        <ci:FluentIcon Glyph="&#xEC64;" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    </Button>
                </Grid>

                <Border Grid.Row="1" Height="1" Margin="4,0,4,6"
                        Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="SessionListStackPanel"/>
                </ScrollViewer>

                <!-- 空状态 -->
                <StackPanel Name="SessionEmptyState" Grid.Row="2" VerticalAlignment="Center"
                            HorizontalAlignment="Center" Spacing="8" IsVisible="False">
                    <ci:FluentIcon Glyph="&#xE3E4;" FontSize="26" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.45"/>
                    <TextBlock Text="还没有会话" FontSize="12" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Opacity="0.7"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 右侧主对话区 -->
        <Grid Grid.Column="1" RowDefinitions="Auto, *, Auto">
            <!-- 顶部栏：展开侧栏按钮、品牌徽标、标题与模型切换器 -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto, Auto, *, Auto" Margin="0,0,0,10">
                <!-- 侧栏收起后，展开按钮停在左缘 -->
                <Button Name="SidebarToggleButton" Grid.Column="0" Classes="ghost"
                        Width="32" Height="32" ToolTip.Tip="展开会话列表"
                        VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="False">
                    <ci:FluentIcon Glyph="&#xEC66;" FontSize="15"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Button>

                <!-- AI 图标徽标 -->
                <Border Grid.Column="1" Width="36" Height="36" CornerRadius="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                        VerticalAlignment="Center" Margin="0,0,10,0">
                    <ci:FluentIcon Glyph="&#xE276;" FontSize="20"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                    <TextBlock Text="AI 助手" Theme="{StaticResource SubtitleTextBlockStyle}"/>
                    <TextBlock Name="HeaderSubTitle" Text="连续智能调课、课表问答与设置调整"
                               Theme="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- 右侧：新建会话（单会话模式可见） + 模型选择 -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Name="NewSessionButton" Theme="{StaticResource TransparentButton}"
                            VerticalAlignment="Center">
                        <ci:IconText Glyph="&#xE00D;" Text="新建会话"/>
                    </Button>
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <ci:FluentIcon Glyph="&#xE4DC;" FontSize="15" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        <ComboBox Name="ModelSelectComboBox" MinWidth="180" MaxWidth="250"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- 消息历史对话流 -->
            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10">
                <ScrollViewer Name="ChatScrollViewer" HorizontalScrollBarVisibility="Disabled" Padding="14,10">
                    <ItemsControl Name="MessagesItemsControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="models:ChatMessageItem">
                                <Grid Margin="0,6">
                                    <!-- 用户消息气泡（右对齐） -->
                                    <StackPanel IsVisible="{Binding IsUser}" HorizontalAlignment="Right"
                                                MaxWidth="480" Margin="36,0,0,0">
                                        <TextBlock Text="{Binding TimeString}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right" Margin="0,0,4,3"
                                                   IsVisible="{Binding TimeString, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                        <Border Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                CornerRadius="14,14,3,14" Padding="13,9">
                                            <SelectableTextBlock Text="{Binding Content}" TextWrapping="Wrap"
                                                                 Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                                 FontSize="14"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- AI 助手消息气泡（左对齐） -->
                                    <StackPanel IsVisible="{Binding IsAssistant}" HorizontalAlignment="Left"
                                                MaxWidth="520" Margin="0,0,36,0">
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,0,0,4">
                                            <ci:FluentIcon Glyph="&#xE276;" FontSize="14"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            <TextBlock Text="AI 助手" FontWeight="SemiBold" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding TimeString}" FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       VerticalAlignment="Center"
                                                       IsVisible="{Binding TimeString, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                            <fa:ProgressRing IsIndeterminate="True" Width="13" Height="13"
                                                             VerticalAlignment="Center"
                                                             IsVisible="{Binding IsThinking}"/>
                                        </StackPanel>

                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="14,14,14,3" Padding="14,10">
                                            <StackPanel Spacing="6">
                                                <!-- 工具调用胶囊徽标 -->
                                                <ItemsControl ItemsSource="{Binding ToolBadges}"
                                                              IsVisible="{Binding HasToolBadges}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel Orientation="Horizontal"/>
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                                    BorderThickness="1" CornerRadius="10"
                                                                    Padding="8,3" Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                                    <ci:FluentIcon Glyph="&#xF4C1;" FontSize="11"
                                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                                   VerticalAlignment="Center"/>
                                                                    <TextBlock Text="{Binding}" FontSize="11"
                                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Markdown 富文本 -->
                                                <mdxaml:MarkdownScrollViewer
                                                    Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                                                    Markdown="{Binding Content}">
                                                    <mdxaml:MarkdownScrollViewer.Styles>
                                                        <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml"/>
                                                        <Style Selector="mdxaml|MarkdownScrollViewer /template/ ScrollViewer">
                                                            <Setter Property="Padding" Value="0"/>
                                                        </Style>
                                                        <Style Selector="avalonia|CTextBlock">
                                                            <Setter Property="FontSize" Value="14"/>
                                                            <Setter Property="Margin" Value="0,0,0,4"/>
                                                        </Style>
                                                    </mdxaml:MarkdownScrollViewer.Styles>
                                                </mdxaml:MarkdownScrollViewer>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <!-- 系统消息（居中胶囊） -->
                                    <StackPanel IsVisible="{Binding IsSystem}" HorizontalAlignment="Center" Margin="0,4">
                                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="12,5">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <ci:FluentIcon Glyph="&#xE9E4;" FontSize="13"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Content}" FontSize="11.5" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- 底部一体化输入区卡片（附件工具栏 + 输入框 + 发送按钮） -->
            <Border Grid.Row="2" Margin="0,10,0,0"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="10,8">
                <StackPanel Spacing="6">
                    <!-- 附件工具栏 -->
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <Button Name="SelectImageButton" Grid.Column="0"
                                Theme="{StaticResource TransparentButton}" Padding="8,3">
                            <ci:IconText Glyph="&#xE9B4;" Text="添加图片"/>
                        </Button>
                        <TextBlock Name="ImageStatusTextBlock" Grid.Column="1"
                                   VerticalAlignment="Center" FontSize="12" Margin="8,0"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="未选择图片，可直接把文件拖进窗口"/>
                        <Button Name="ClearImageButton" Grid.Column="2"
                                Theme="{StaticResource TransparentButton}"
                                Foreground="IndianRed" Padding="8,3" IsVisible="False">
                            <ci:IconText Glyph="&#xE671;" Text="清除"/>
                        </Button>
                    </Grid>

                    <!-- 输入与发送 -->
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Name="InputTextBox"
                                 Watermark="输入消息（Enter 发送，Shift + Enter 换行）..."
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                 MinHeight="38" MaxHeight="120"
                                 VerticalContentAlignment="Center"/>
                        <Button Name="SendButton" Grid.Column="1" Margin="8,0,0,0"
                                Classes="accent" Height="38" Padding="16,0"
                                VerticalAlignment="Bottom">
                            <ci:IconText Glyph="&#xEF11;" Text="发送"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 拖拽提示遮罩层 -->
        <Grid Name="DropOverlay" Grid.ColumnSpan="2" IsVisible="False" IsHitTestVisible="False"
              Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
            <Rectangle Margin="8" RadiusX="12" RadiusY="12" StrokeThickness="1.5"
                       StrokeDashArray="4,3" Opacity="0.75"
                       Stroke="{DynamicResource AccentFillColorDefaultBrush}"/>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="6">
                <ci:FluentIcon Glyph="&#xE4E6;" FontSize="40" HorizontalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="松开以添加文件" Theme="{StaticResource SubtitleTextBlockStyle}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="图片会作为附件发送，文本文件的内容会填进输入框"
                           Theme="{StaticResource CaptionTextBlockStyle}"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            </StackPanel>
        </Grid>
    </Grid>
</ci:MyWindow>
