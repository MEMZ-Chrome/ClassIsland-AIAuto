<ci:SettingsPageBase x:Class="ClassIsland.Automation.V2.Views.SettingsPages.AutomationSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d">
    <ci:SettingsPageBase.Styles>
        <!-- 预置模板胶囊 -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="11,5"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <!-- 无边框图标按钮 -->
        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}"/>
        </Style>
    </ci:SettingsPageBase.Styles>
    <Grid>
        <!-- 密码/TOTP 访问锁定遮罩层 -->
        <Border Name="LockOverlayBorder" IsVisible="False"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="12" Padding="28"
                MaxWidth="440" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="20">
                <TextBlock Text="安全访问保护" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>

                <StackPanel Spacing="8">
                    <TextBlock Text="固定密码或 6 位动态验证码" FontSize="13"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <Grid ColumnDefinitions="*, Auto">
                        <TextBox Name="UnlockPasswordBox" PasswordChar="*" HorizontalAlignment="Stretch"/>
                        <Button Name="UnlockButton" Grid.Column="1" Margin="8,0,0,0" Content="解锁" Classes="accent"/>
                    </Grid>
                    <TextBlock Name="UnlockErrorTextBlock" FontSize="12" IsVisible="False" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </StackPanel>

                <TextBlock Name="LockHintTextBlock" FontSize="12" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="验证前页面不会锁定，TOTP 也不会生效。"/>
            </StackPanel>
        </Border>

        <!-- 主设置内容区域 -->
        <ScrollViewer Name="MainSettingsScrollViewer" IsVisible="True">
            <!-- settings-container 由 ClassIsland 主题提供：MaxWidth 960、外边距与间距，
                 跟随宿主的设置页规范，不要自己写死宽度。 -->
            <StackPanel Classes="settings-container" Spacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Text="IslandAgent设置" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="模型服务、偏好与安全防护" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <TabControl>
                    <!-- 选项卡 1：模型服务 -->
                    <TabItem Header="模型服务">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="模型服务" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                <Button Name="AddProviderButton" Grid.Column="1" Content="添加供应商" Classes="accent"/>
                            </Grid>

                            <!-- 供应商卡片列表容器 -->
                            <StackPanel Name="ProvidersListContainer" Spacing="8"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 2：高级偏好 -->
                    <TabItem Header="高级偏好">
                        <StackPanel Spacing="16" Margin="0,12,0,0">
                            <!-- 功能权限开关 -->
                            <StackPanel Spacing="8">
                                <CheckBox Name="IsMemoryEnabledCheckBox" Content="启用长期记忆" IsChecked="True"/>
                                <CheckBox Name="IsCommandExecutionEnabledCheckBox" Content="允许 AI 执行命令行命令"/>
                                <TextBlock Text="开启后 AI 可执行终端指令，请确认信任当前模型。" FontSize="12" TextWrapping="Wrap"
                                           Margin="28,-2,0,0"
                                           Foreground="{DynamicResource SystemFillColorCautionBrush}"/>
                            </StackPanel>

                            <!-- 会话管理 -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="会话管理" FontWeight="SemiBold"/>
                                <CheckBox Name="IsMultiSessionEnabledCheckBox"
                                          Content="启用多会话模式（聊天窗口左侧显示会话列表，各会话历史独立）" IsChecked="True"/>
                                <CheckBox Name="SessionSidebarExpandedCheckBox" Margin="28,0,0,0"
                                          Content="打开窗口时默认展开会话列表（关闭后默认收起，点左上角按钮展开）"
                                          IsChecked="True"/>
                                <CheckBox Name="NewSessionOnOpenCheckBox"
                                          Content="每次打开对话窗口时新建会话（关闭则继续上一次会话）"/>
                                <CheckBox Name="AiSessionTitleCheckBox"
                                          Content="会话标题由 AI 总结生成（每会话首次对话后自动命名，额外消耗少量 token）"/>
                                <CheckBox Name="BackgroundTaskNotificationCheckBox"
                                          Content="后台任务完成时发送系统通知"/>
                                <TextBlock Text="对话历史保存在本机插件目录的 sessions.json 中，最多保留最近 30 个会话；关闭多会话模式后仍按单会话继续使用最近一次历史。"
                                           FontSize="12" TextWrapping="Wrap" Margin="28,-2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <!-- 工具调用轮数上限 -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="工具调用轮数上限" FontWeight="SemiBold"/>
                                <Grid ColumnDefinitions="120, *">
                                    <NumericUpDown Name="MaxToolIterationsNumeric"
                                                   Minimum="1" Maximum="50" Increment="1"
                                                   FormatString="0"
                                                   HorizontalAlignment="Left" Width="120"/>
                                    <TextBlock Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"
                                               FontSize="12" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="单次提问内 AI 最多连续调用工具的轮数，超出后停止。数值越大越能完成复杂任务，API 调用与费用也越多。"/>
                                </Grid>
                            </StackPanel>

                            <!-- 自定义系统提示词 -->
                            <StackPanel Spacing="6">
                                <TextBlock Text="自定义系统提示词" FontWeight="SemiBold"/>
                                <TextBox Name="CustomPromptTextBox" AcceptsReturn="True" Height="88" TextWrapping="Wrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>

                            <!-- 长期记忆管理 -->
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="长期记忆" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Name="ClearMemoryButton" Grid.Column="1" Content="清空"/>
                                </Grid>
                                <TextBox Name="CustomMemoryTextBox" AcceptsReturn="True" Height="104" TextWrapping="Wrap"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                            </StackPanel>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 3：安全防护 -->
                    <TabItem Header="安全防护">
                        <StackPanel Spacing="12" Margin="0,12,0,0">
                            <!-- 固定密码 -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="10">
                                    <TextBlock Name="PasswordStatusTextBlock" Text="当前状态：未设置固定密码（默认无密码）" FontWeight="SemiBold"/>
                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                        <TextBox Name="NewPasswordBox" PasswordChar="*" HorizontalAlignment="Stretch"/>
                                        <Button Name="SavePasswordButton" Grid.Column="1" Margin="8,0,0,0" Content="更新密码"/>
                                        <Button Name="ClearPasswordButton" Grid.Column="2" Margin="8,0,0,0" Content="清除密码" IsVisible="False"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- TOTP 动态口令 -->
                            <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="8" Padding="14">
                                <StackPanel Spacing="12">
                                    <TextBlock Name="TotpStatusTextBlock" Text="当前状态：未启用 TOTP 动态口令" FontWeight="SemiBold"/>

                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Name="SetupTotpButton" Content="生成并配置 TOTP"/>
                                        <Button Name="DisableTotpButton" Content="关闭 TOTP 保护" IsVisible="False"/>
                                    </StackPanel>

                                    <!-- TOTP 暂存与绑定配置卡片 -->
                                    <Border Name="TotpSetupCard" IsVisible="False"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="8" Padding="14">
                                        <StackPanel Spacing="14">
                                            <TextBlock Text="验证成功前 TOTP 不会生效，页面也不会被锁定。" FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>

                                            <!-- 密钥字符串 -->
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="密钥字符串" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <Grid ColumnDefinitions="*, Auto">
                                                    <TextBox Name="TotpSecretStringTextBox" IsReadOnly="True"
                                                             FontFamily="Consolas, monospace" FontSize="14"
                                                             HorizontalAlignment="Stretch"/>
                                                    <Button Name="CopyTotpSecretButton" Grid.Column="1" Margin="8,0,0,0" Content="复制"/>
                                                </Grid>
                                            </StackPanel>

                                            <!-- 二维码 -->
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="绑定二维码" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <Border Background="White" CornerRadius="8" HorizontalAlignment="Left" Padding="8">
                                                    <Image Name="TotpQrCodeImage" Width="160" Height="160"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- 激活验证 -->
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="输入 6 位验证码完成激活" FontSize="12"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <Grid ColumnDefinitions="140, Auto, Auto">
                                                    <TextBox Name="TotpVerifyCodeTextBox" MaxLength="6"/>
                                                    <Button Name="VerifyAndActivateTotpButton" Grid.Column="1" Margin="8,0,0,0" Content="激活" Classes="accent"/>
                                                    <Button Name="CancelPendingTotpButton" Grid.Column="2" Margin="8,0,0,0" Content="取消"/>
                                                </Grid>
                                                <TextBlock Name="TotpVerifyResultTextBlock" FontSize="12" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- 保存设置常驻按钮栏 -->
                <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,4,0,0">
                    <Button Name="SaveButton" Content="保存" Classes="accent"/>
                    <TextBlock Name="StatusTextBlock" VerticalAlignment="Center"
                               Foreground="{DynamicResource SystemFillColorSuccessBrush}"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 供应商 添加/编辑 模态弹窗遮罩层 -->
        <Grid Name="ProviderDialogOverlay" IsVisible="False" Background="#8C000000">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    CornerRadius="16" Width="520" MaxHeight="660"
                    BoxShadow="0 10 32 0 #40000000"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <!-- 标题区：标题 + 一句话说明，右上角关闭 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="22,18,14,14">
                        <StackPanel Spacing="3">
                            <TextBlock Name="DialogTitleTextBlock" Text="添加供应商" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Name="DialogSubtitleTextBlock" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="填好别名、地址和密钥就能用。预置模板只填地址，密钥要自己填。"/>
                        </StackPanel>
                        <Button Name="DialogCloseButton" Grid.Column="1" Classes="ghost" VerticalAlignment="Top"
                                ToolTip.Tip="关闭">
                            <Path Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"
                                  Width="10" Height="10" Stretch="Uniform"
                                  Fill="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- 表单区 -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="14" Margin="22,16,22,8">
                            <StackPanel Spacing="6">
                                <TextBlock Text="快速填充" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <WrapPanel Name="PresetButtonsWrapPanel" Orientation="Horizontal"/>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="供应商别名" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBox Name="DialogNameTextBox" Watermark="例如：DeepSeek"/>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="API 地址" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBox Name="DialogBaseUrlTextBox" Watermark="https://api.deepseek.com"/>
                                <TextBlock Text="可以不写 /v1，请求失败时会自动补上再试一次。" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>

                            <StackPanel Spacing="5">
                                <TextBlock Text="API 密钥" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <TextBox Name="DialogApiKeyTextBox" PasswordChar="*" Watermark="sk-..."/>
                            </StackPanel>

                            <!-- 模型：标题行 + 手动添加行 + 列表，列表不再套第二层边框 -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="模型" FontSize="11" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Button Name="DialogFetchModelsButton" Grid.Column="1" Content="从接口获取"/>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Name="DialogNewModelTextBox" Watermark="或手动输入模型名"/>
                                    <Button Name="DialogAddModelButton" Grid.Column="1" Margin="8,0,0,0" Content="添加"/>
                                </Grid>

                                <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="8" Padding="6,4" MaxHeight="150">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Name="DialogModelsContainer" Spacing="2"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作区：错误提示在左，按钮固定在右下角，不随内容滚动 -->
                    <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="22,12,20,14"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Name="DialogErrorTextBlock" IsVisible="False" FontSize="11.5"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Name="DialogCancelButton" Content="取消"/>
                                <Button Name="DialogSaveButton" Content="保存" Classes="accent"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 顶部 Toast 提示浮层 -->
        <Border Name="ToastBorder" IsVisible="False"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,20,0,0" CornerRadius="8"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                Padding="18,10">
            <TextBlock Name="ToastMessageTextBlock" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Border>
    </Grid>
</ci:SettingsPageBase>
