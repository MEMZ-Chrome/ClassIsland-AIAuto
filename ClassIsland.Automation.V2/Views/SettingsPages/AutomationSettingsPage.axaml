<ci:SettingsPageBase x:Class="ClassIsland.Automation.V2.Views.SettingsPages.AutomationSettingsPage"
                     xmlns="https://github.com/avaloniaui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:ci="http://classisland.tech/schemas/xaml/core"
                     xmlns:fa="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                     xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                     xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                     mc:Ignorable="d">
    <ci:SettingsPageBase.Styles>
        <!-- 预置模板胶囊 -->
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="11,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
        </Style>
        <Style Selector="Button.chip:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>

        <!-- 动态文本样式类（代码创建控件时通过 Classes 挂载，自动跟随深浅主题） -->
        <Style Selector="TextBlock.subtle">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="TextBlock.status-success">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}"/>
        </Style>
        <Style Selector="TextBlock.status-error">
            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}"/>
        </Style>
    </ci:SettingsPageBase.Styles>

    <Grid>
        <!-- 密码/TOTP 访问锁定遮罩层 -->
        <Border Name="LockOverlayBorder" IsVisible="False"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1" CornerRadius="8" Padding="28" Margin="16"
                MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center">
            <StackPanel Spacing="16">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <ci:FluentIcon Glyph="&#xEF63;" FontSize="36" HorizontalAlignment="Center"
                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                    <TextBlock Text="安全访问保护" Theme="{StaticResource SubtitleTextBlockStyle}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Name="LockHintTextBlock" Theme="{StaticResource CaptionTextBlockStyle}"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="验证前页面不会锁定，TOTP 也不会生效。"/>
                </StackPanel>

                <StackPanel Spacing="6">
                    <ci:Field Label="固定密码或 6 位动态验证码">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Name="UnlockPasswordBox" PasswordChar="●"
                                     Watermark="请输入密码或 6 位验证码"
                                     HorizontalAlignment="Stretch"/>
                            <Button Name="UnlockButton" Grid.Column="1" Margin="8,0,0,0" Classes="accent">
                                <ci:IconText Glyph="&#xEAF8;" Text="解锁"/>
                            </Button>
                        </Grid>
                    </ci:Field>
                    <TextBlock Name="UnlockErrorTextBlock" FontSize="12" IsVisible="False" TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- 主设置内容区域（标题已由 ClassIsland 2.x 设置窗口顶栏统一渲染，此处不再重复） -->
        <ScrollViewer Name="MainSettingsScrollViewer" IsVisible="True">
            <StackPanel Classes="settings-container animated-intro">
                <TabControl Classes="compact" ClipToBounds="False" Padding="0" Margin="0">
                    <!-- 选项卡 1：模型服务 -->
                    <TabItem Header="模型服务">
                        <StackPanel Classes="animated-intro" Spacing="4" Margin="0,10,0,0">
                            <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,4">
                                <ci:IconText Glyph="&#xE4DC;" Text="模型供应商" VerticalAlignment="Center"/>
                                <Button Name="AddProviderButton" Grid.Column="1" Classes="accent">
                                    <ci:IconText Glyph="&#xE00D;" Text="添加供应商"/>
                                </Button>
                            </Grid>

                            <!-- 供应商 SettingsExpander 列表容器 -->
                            <StackPanel Name="ProvidersListContainer" Spacing="4"/>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 2：高级偏好 -->
                    <TabItem Header="高级偏好">
                        <StackPanel Classes="animated-intro" Spacing="4" Margin="0,10,0,0">
                            <!-- 功能与权限 -->
                            <ci:IconText Glyph="&#xE84F;" Text="功能与权限" Margin="0,0,0,4"/>

                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE29E;}"
                                                 Header="启用长期记忆"
                                                 Description="开启后 AI 会在对话中自动参考并更新下方的长期记忆内容。">
                                <fa:SettingsExpander.Footer>
                                    <ToggleSwitch Name="IsMemoryEnabledCheckBox" IsChecked="True"/>
                                </fa:SettingsExpander.Footer>
                            </fa:SettingsExpander>

                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xF499;}"
                                                 Header="允许 AI 执行命令行命令"
                                                 Description="开启后 AI 可调用系统终端执行命令，存在较高安全风险，请仅在信任当前模型时启用。">
                                <fa:SettingsExpander.Footer>
                                    <ToggleSwitch Name="IsCommandExecutionEnabledCheckBox"/>
                                </fa:SettingsExpander.Footer>
                            </fa:SettingsExpander>

                            <fa:InfoBar Name="CommandWarningBanner"
                                        Severity="Warning" IsClosable="False"
                                        IsOpen="True" IsVisible="False"
                                        Message="已开启命令行执行权限：AI 可直接运行本机终端指令，请确认信任当前模型并做好安全防护。"/>

                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE125;}"
                                                 Header="工具调用轮数上限"
                                                 Description="单次提问内 AI 最多连续调用工具的轮数（1–50）。数值越大越能完成复杂任务，API 调用与费用也越多。">
                                <fa:SettingsExpander.Footer>
                                    <ci:Field VerticalAlignment="Center" Suffix="轮">
                                        <NumericUpDown Name="MaxToolIterationsNumeric"
                                                       Minimum="1" Maximum="50" Increment="1"
                                                       FormatString="0" MinWidth="120"/>
                                    </ci:Field>
                                </fa:SettingsExpander.Footer>
                            </fa:SettingsExpander>

                            <!-- 会话与通知 -->
                            <Separator Margin="0,12,0,4"/>
                            <ci:IconText Glyph="&#xE3FE;" Text="会话与通知" Margin="0,0,0,4"/>

                            <fa:SettingsExpander Name="MultiSessionExpander"
                                                 IconSource="{ci:FluentIconSource &#xE3FE;}"
                                                 Header="启用多会话模式"
                                                 Description="聊天窗口左侧显示会话列表，各会话历史独立保存在插件目录 sessions.json 中（最多保留 30 个会话）。"
                                                 IsExpanded="True">
                                <fa:SettingsExpander.Footer>
                                    <ToggleSwitch Name="IsMultiSessionEnabledCheckBox" IsChecked="True"/>
                                </fa:SettingsExpander.Footer>
                                <fa:SettingsExpanderItem Name="SessionSidebarExpandedItem"
                                                         IconSource="{ci:FluentIconSource &#xEC60;}"
                                                         Content="打开窗口时默认展开会话列表"
                                                         Description="关闭后默认收起侧栏，需要时可点击窗口左上角按钮展开。">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ToggleSwitch Name="SessionSidebarExpandedCheckBox" IsChecked="True"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander>

                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE3E6;}"
                                                 Header="每次打开窗口时新建会话"
                                                 Description="开启后每次打开对话窗口自动开始新会话，关闭则继续上一次对话历史。">
                                <fa:SettingsExpander.Footer>
                                    <ToggleSwitch Name="NewSessionOnOpenCheckBox"/>
                                </fa:SettingsExpander.Footer>
                            </fa:SettingsExpander>

                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE40A;}"
                                                 Header="AI 自动总结会话标题"
                                                 Description="每会话首次对话后由模型自动命名，会额外消耗少量 Token。">
                                <fa:SettingsExpander.Footer>
                                    <ToggleSwitch Name="AiSessionTitleCheckBox"/>
                                </fa:SettingsExpander.Footer>
                            </fa:SettingsExpander>

                            <fa:SettingsExpander Name="BackgroundNotificationExpander"
                                                 IconSource="{ci:FluentIconSource &#xE025;}"
                                                 Header="后台任务完成时发送系统通知"
                                                 Description="关闭或隐藏对话窗口后，AI 后台任务完成时通过 ClassIsland 提醒通知您。">
                                <fa:SettingsExpander.Footer>
                                    <ToggleSwitch Name="BackgroundTaskNotificationCheckBox"/>
                                </fa:SettingsExpander.Footer>
                                <fa:SettingsExpanderItem Name="AiNotificationSummaryItem"
                                                         IconSource="{ci:FluentIconSource &#xE40A;}"
                                                         Content="AI 单独生成单行通知摘要"
                                                         Description="开启后额外调用模型生成 10～20 字简短摘要，确保状态栏单行完整显示（关闭则直接截取原回复首行）。">
                                    <fa:SettingsExpanderItem.Footer>
                                        <ToggleSwitch Name="AiNotificationSummaryCheckBox" IsChecked="True"/>
                                    </fa:SettingsExpanderItem.Footer>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander>

                            <!-- 提示词与记忆 -->
                            <Separator Margin="0,12,0,4"/>
                            <ci:IconText Glyph="&#xE6BB;" Text="提示词与记忆" Margin="0,0,0,4"/>

                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE74F;}"
                                                 Header="自定义系统提示词"
                                                 Description="附加到系统提示词中，用于定制 AI 的回复风格、称呼或课堂规则。"
                                                 IsExpanded="True">
                                <fa:SettingsExpanderItem>
                                    <TextBox Name="CustomPromptTextBox"
                                             Watermark="输入自定义系统提示词（留空使用默认）"
                                             AcceptsReturn="True" Height="96" TextWrapping="Wrap"
                                             HorizontalAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander>

                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xE5FD;}"
                                                 Header="长期记忆内容"
                                                 Description="记录教室、作息或课表相关的长期信息，开启长期记忆后会自动提供给 AI。"
                                                 IsExpanded="True">
                                <fa:SettingsExpander.Footer>
                                    <Button Name="ClearMemoryButton"
                                            Theme="{StaticResource TransparentButton}"
                                            Foreground="IndianRed">
                                        <ci:IconText Glyph="&#xE61D;" Text="清空"/>
                                    </Button>
                                </fa:SettingsExpander.Footer>
                                <fa:SettingsExpanderItem>
                                    <TextBox Name="CustomMemoryTextBox"
                                             Watermark="长期记忆内容（也可在对话中让 AI 自动更新）"
                                             AcceptsReturn="True" Height="108" TextWrapping="Wrap"
                                             HorizontalAlignment="Stretch"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander>
                        </StackPanel>
                    </TabItem>

                    <!-- 选项卡 3：安全防护 -->
                    <TabItem Header="安全防护">
                        <StackPanel Classes="animated-intro" Spacing="4" Margin="0,10,0,0">
                            <ci:IconText Glyph="&#xEF63;" Text="访问保护" Margin="0,0,0,4"/>

                            <!-- 固定密码 -->
                            <fa:SettingsExpander IconSource="{ci:FluentIconSource &#xEC8B;}"
                                                 Header="固定密码"
                                                 Description="设置访问保护密码，打开设置页或执行敏感操作时验证。"
                                                 IsExpanded="True">
                                <fa:SettingsExpander.Footer>
                                    <Button Name="ClearPasswordButton"
                                            Theme="{StaticResource TransparentButton}"
                                            Foreground="IndianRed" IsVisible="False">
                                        <ci:IconText Glyph="&#xE671;" Text="清除密码"/>
                                    </Button>
                                </fa:SettingsExpander.Footer>
                                <fa:SettingsExpanderItem>
                                    <StackPanel Spacing="10" HorizontalAlignment="Stretch">
                                        <TextBlock Name="PasswordStatusTextBlock"
                                                   Text="当前状态：未设置固定密码（默认无密码）"
                                                   FontSize="12.5" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <Grid ColumnDefinitions="*, Auto">
                                            <TextBox Name="NewPasswordBox" PasswordChar="●"
                                                     Watermark="输入新密码（留空更新则清除密码）"
                                                     HorizontalAlignment="Stretch"/>
                                            <Button Name="SavePasswordButton" Grid.Column="1" Margin="8,0,0,0"
                                                    Classes="accent">
                                                <ci:IconText Glyph="&#xEEB5;" Text="更新密码"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander>

                            <!-- TOTP 动态口令 -->
                            <fa:SettingsExpander Name="TotpExpander"
                                                 IconSource="{ci:FluentIconSource &#xEE2D;}"
                                                 Header="TOTP 动态口令"
                                                 Description="使用手机或手环的验证器 App（如 Microsoft Authenticator）生成 6 位动态验证码。"
                                                 IsExpanded="True">
                                <fa:SettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Button Name="SetupTotpButton" Content="生成并配置 TOTP"/>
                                        <Button Name="DisableTotpButton"
                                                Theme="{StaticResource TransparentButton}"
                                                Foreground="IndianRed" Content="关闭 TOTP" IsVisible="False"/>
                                    </StackPanel>
                                </fa:SettingsExpander.Footer>

                                <fa:SettingsExpanderItem>
                                    <TextBlock Name="TotpStatusTextBlock"
                                               Text="当前状态：未启用 TOTP 动态口令"
                                               FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </fa:SettingsExpanderItem>

                                <!-- TOTP 暂存与绑定配置项 -->
                                <fa:SettingsExpanderItem Name="TotpSetupCard" IsVisible="False">
                                    <StackPanel Spacing="14" HorizontalAlignment="Stretch">
                                        <fa:InfoBar Severity="Informational" IsClosable="False" IsOpen="True"
                                                    Message="验证成功前 TOTP 不会生效，页面也不会被锁定。"/>

                                        <Grid ColumnDefinitions="Auto, *">
                                            <!-- 二维码 -->
                                            <StackPanel Grid.Column="0" Spacing="6" Margin="0,0,18,0"
                                                        VerticalAlignment="Top">
                                                <Border Background="White" CornerRadius="8" Padding="8">
                                                    <Image Name="TotpQrCodeImage" Width="156" Height="156"/>
                                                </Border>
                                                <TextBlock Text="扫码绑定验证器"
                                                           Theme="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           HorizontalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 密钥与激活验证 -->
                                            <StackPanel Grid.Column="1" Spacing="12" VerticalAlignment="Center">
                                                <ci:Field Label="密钥字符串">
                                                    <Grid ColumnDefinitions="*, Auto">
                                                        <TextBox Name="TotpSecretStringTextBox" IsReadOnly="True"
                                                                 FontFamily="Consolas, monospace" FontSize="13.5"
                                                                 HorizontalAlignment="Stretch"/>
                                                        <Button Name="CopyTotpSecretButton" Grid.Column="1"
                                                                Margin="8,0,0,0">
                                                            <ci:IconText Glyph="&#xE58B;" Text="复制"/>
                                                        </Button>
                                                    </Grid>
                                                </ci:Field>

                                                <ci:Field Label="输入 6 位验证码完成激活">
                                                    <Grid ColumnDefinitions="*, Auto, Auto">
                                                        <TextBox Name="TotpVerifyCodeTextBox" MaxLength="6"
                                                                 Watermark="6 位动态验证码"/>
                                                        <Button Name="VerifyAndActivateTotpButton" Grid.Column="1"
                                                                Margin="8,0,0,0" Classes="accent">
                                                            <ci:IconText Glyph="&#xE424;" Text="激活"/>
                                                        </Button>
                                                        <Button Name="CancelPendingTotpButton" Grid.Column="2"
                                                                Margin="6,0,0,0" Content="取消"/>
                                                    </Grid>
                                                </ci:Field>

                                                <TextBlock Name="TotpVerifyResultTextBlock" FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </fa:SettingsExpanderItem>
                            </fa:SettingsExpander>
                        </StackPanel>
                    </TabItem>
                </TabControl>

                <!-- 底部状态与立即保存栏 -->
                <Separator Margin="0,12,0,4"/>
                <Grid ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                    <TextBlock Name="StatusTextBlock" VerticalAlignment="Center" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="所有更改均会自动保存"/>
                    <Button Name="SaveButton" Grid.Column="1" Theme="{StaticResource TransparentButton}">
                        <ci:IconText Glyph="&#xEEB5;" Text="立即保存"/>
                    </Button>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- 供应商 添加/编辑 模态弹窗遮罩层（WinUI 3 ContentDialog 视觉风格） -->
        <Grid Name="ProviderDialogOverlay" IsVisible="False" Background="#8C000000">
            <Border Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="8" Width="520" MaxHeight="660"
                    BoxShadow="0 8 32 0 #40000000"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Grid RowDefinitions="Auto, Auto, *, Auto">
                    <!-- 标题区 -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="20,16,12,12">
                        <StackPanel Spacing="3">
                            <TextBlock Name="DialogTitleTextBlock" Text="添加供应商"
                                       Theme="{StaticResource SubtitleTextBlockStyle}"/>
                            <TextBlock Name="DialogSubtitleTextBlock"
                                       Theme="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                       Text="填好别名、地址和密钥就能用。预置模板只填地址，密钥要自己填。"/>
                        </StackPanel>
                        <Button Name="DialogCloseButton" Grid.Column="1"
                                Theme="{StaticResource TransparentButton}"
                                VerticalAlignment="Top" ToolTip.Tip="关闭">
                            <ci:FluentIcon Glyph="&#xE671;" FontSize="14"/>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}"/>

                    <!-- 表单区 -->
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="12" Margin="20,14,20,10">
                            <StackPanel Spacing="6">
                                <TextBlock Text="快速填充" Theme="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                <WrapPanel Name="PresetButtonsWrapPanel" Orientation="Horizontal"/>
                            </StackPanel>

                            <ci:Field Label="供应商别名">
                                <TextBox Name="DialogNameTextBox" Watermark="例如：DeepSeek"/>
                            </ci:Field>

                            <StackPanel Spacing="4">
                                <ci:Field Label="API 地址">
                                    <TextBox Name="DialogBaseUrlTextBox" Watermark="https://api.deepseek.com"/>
                                </ci:Field>
                                <TextBlock Text="可以不写 /v1，请求失败时会自动补上再试一次。"
                                           Theme="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>

                            <ci:Field Label="API 密钥">
                                <TextBox Name="DialogApiKeyTextBox" PasswordChar="●" Watermark="sk-..."/>
                            </ci:Field>

                            <!-- 模型列表区 -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Text="模型列表" Theme="{StaticResource CaptionTextBlockStyle}"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <Button Name="DialogFetchModelsButton" Grid.Column="1"
                                            Theme="{StaticResource TransparentButton}">
                                        <ci:IconText Glyph="&#xE161;" Text="从接口获取"/>
                                    </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBox Name="DialogNewModelTextBox" Watermark="手动输入模型名，按回车添加"/>
                                    <Button Name="DialogAddModelButton" Grid.Column="1" Margin="8,0,0,0">
                                        <ci:IconText Glyph="&#xE00D;" Text="添加"/>
                                    </Button>
                                </Grid>

                                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="8,4" MaxHeight="150">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel Name="DialogModelsContainer" Spacing="2"/>
                                    </ScrollViewer>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 底部操作区：WinUI 3 对话框底部浅底栏，错误提示在左，按钮在右 -->
                    <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="20,12,18,12"
                            CornerRadius="0,0,8,8"
                            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBlock Name="DialogErrorTextBlock" IsVisible="False" FontSize="12"
                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Name="DialogCancelButton" Content="取消"/>
                                <Button Name="DialogSaveButton" Classes="accent">
                                    <ci:IconText Glyph="&#xE424;" Text="保存"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ci:SettingsPageBase>
