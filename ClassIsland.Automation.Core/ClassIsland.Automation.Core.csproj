<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      核心库需要同时被 1.x 与 2.x 两个插件外壳引用，而这两代宿主的 ClassIsland.Shared
      程序集版本不同（1.x 为 1.x 版本号，2.x 为 2.x 版本号），无法共用一份引用。
      因此按目标框架区分：
        net8.0          -> 2.x（Avalonia）
        net8.0-windows  -> 1.x（WPF）
      两种宿主下 Core 用到的类型（IAppHost、IPublicProfileService、
      IPublicUriNavigationService、Profile 及其成员）名称与签名完全一致，
      故无需条件编译，只需切换包版本。
    -->
    <TargetFrameworks>net8.0;net8.0-windows</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>ClassIsland.Automation.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <!-- 2.x 宿主：ClassIsland.Shared / Shared.IPC 2.0.4 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="ClassIsland.Shared.IPC" Version="2.0.4">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ClassIsland.Shared" Version="2.0.4">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- 1.x 宿主：ClassIsland.Shared / Shared.IPC 1.7.0.1 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="ClassIsland.Shared.IPC" Version="1.7.0.1">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="ClassIsland.Shared" Version="1.7.0.1">
      <ExcludeAssets>runtime; native</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
